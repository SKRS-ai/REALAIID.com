    if (!sovereignID) {
        return res.status(400).json({
            success: false,
            error: "MISSING_SOVEREIGN_ID",
            message: "A verified biological sovereign reference key is required to seat environmental tokens."
        });
    }

    try {
        const offsetMetric = parseFloat(carbonCredits) || 0;
        const efficiencyMetric = parseFloat(loopClosureRate) || 0;

        const structuralIndex = calculateSustainabilityIndex(offsetMetric, efficiencyMetric);

        if (structuralIndex <= 0) {
            return res.status(422).json({
                success: false,
                error: "INVALID_SUSTAINABILITY_METRICS",
                message: "Telemetry values are insufficient to generate infrastructure optimization seals."
            });
        }

        logger.info(`[AMBIENT SYNC] Anchoring closed-loop ecosystem variables for entity node: ${sovereignID}`);
